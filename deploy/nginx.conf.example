# Example nginx reverse proxy (optional — WhiteNoise already serves static).
# Terminates TLS and forwards to gunicorn. Adjust server_name and cert paths.
server {
    listen 443 ssl;
    server_name treasury.yourchurch.org;

    ssl_certificate     /etc/letsencrypt/live/treasury.yourchurch.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/treasury.yourchurch.org/privkey.pem;

    client_max_body_size 25M;   # allow statement uploads

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 80;
    server_name treasury.yourchurch.org;
    return 301 https://$host$request_uri;
}
