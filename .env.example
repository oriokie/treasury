# Copy to .env and adjust. All values are optional in development.

# --- General ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Branding shown in the UI
SITE_NAME=Treasury
CHURCH_NAME=Central SDA Church

# Require treasurer approval before an expense affects fund balances.
# Set to False to auto-approve expenses on entry.
EXPENSE_REQUIRE_APPROVAL=True

# --- Database ---
# Leave these unset to use the bundled SQLite database (db.sqlite3).
# Set all of them to use PostgreSQL instead.
# POSTGRES_DB=treasury
# POSTGRES_USER=treasury
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Production hardening (only used when DJANGO_DEBUG=False) ---
# DJANGO_SECURE_SSL_REDIRECT=True
