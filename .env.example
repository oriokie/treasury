# Copy to .env and adjust. All values are optional in development.
#
# This file is TRACKED IN GIT and ships to every clone, so nothing in it is a
# real value — it once carried a live secret key, the production hostname and
# working MySQL credentials, which is how a template quietly becomes a leak.
# Every example below is deliberately not usable: any value beginning
# "change-me" must be replaced before the app is exposed to anyone. Never paste
# a real secret in here; put it in .env, which is gitignored.

# --- General ---
# Generate a fresh one per installation and keep it out of version control:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
# Changing it later logs everyone out AND (unless TREASURY_ENCRYPTION_KEY is
# set) makes already-encrypted settings unreadable, so set it once, at install.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Off by default, and deliberately: this file exists to be COPIED, and a copy
# that reaches a server with debugging on serves a full stack trace — settings,
# environment and all — to whoever triggers an error. Turn it on for a laptop,
# never for anything anyone else can reach.
DJANGO_DEBUG=False
# The domain(s) this instance answers on, comma separated. With DEBUG off, an
# unset value means "any host", which the app warns about at startup.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#DJANGO_ALLOWED_HOSTS=treasury.yourchurch.org

# Branding shown in the UI
SITE_NAME=Church Treasury
CHURCH_NAME=Example SDA Church

# Require treasurer approval before an expense affects fund balances.
# Set to False to auto-approve expenses on entry.
EXPENSE_REQUIRE_APPROVAL=True

# --- Database ---
# Leave every one of these unset to use the bundled SQLite database
# (db.sqlite3). Setting POSTGRES_DB switches the app to PostgreSQL; setting
# MYSQL_DB switches it to MySQL/MariaDB. That is why they are commented out
# rather than left blank — an uncommented name here points a fresh copy at a
# database that does not exist.
# POSTGRES_DB=treasury
# POSTGRES_USER=treasury
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# MySQL/MariaDB (the usual choice on cPanel, where the database and its user
# are created in cPanel → MySQL Databases and the names get the account prefix).
# POSTGRES_DB takes priority if both are set.
# MYSQL_DB=cpaneluser_treasury
# MYSQL_USER=cpaneluser_trez
# MYSQL_PASSWORD=change-me-to-the-database-password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# --- Production hardening (only used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
